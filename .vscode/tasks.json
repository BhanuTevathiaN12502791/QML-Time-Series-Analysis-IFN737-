      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Events: Run holiday and seasonal study",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "event_study.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Project: Reproduce full anomaly benchmark",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "run_all.py",
        "--fetch",
        "--workers",
        "3"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Data: Fetch 2025 holiday/event traffic",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": [],
      "args": [
        "fetch_event_data.py"
      ]
    },
    {
      "label": "Python: Install report and notebook dependencies",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": [],
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements-report.txt",
        "ipykernel",
        "debugpy"
      ]
    },
    {
      "label": "Report: Build final PDF",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": [],
      "args": [
        "build_final_report.py",
        "--out",
        "${workspaceFolder}/results/final_report.pdf"
      ]
    }
  ]
}

      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Curves: Plot fresh local learning curves",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "plot_learning_curves.py",
        "--results",
